<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Kern-Schnittstelle für Plugins (docs/plugins-konzept.md, Abschnitt 5). Stufe 1 (SdkInfo.Level). Innerhalb einer Stufe wird
    nur hinzugefügt; Entfernen oder Ändern nur mit neuer Stufe. Plugins verweisen nur hierauf (Private=false: geladen wird die
    Fassung des Kerns).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DmOffice.Sdk</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
