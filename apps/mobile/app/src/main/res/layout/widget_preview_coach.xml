<?xml version="1.0" encoding="utf-8"?>
<!-- Vorschau in der Widget-Auswahl (Beispielwerte) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:background="@drawable/widget_bg">
    <TextView android:layout_width="64dp" android:layout_height="64dp" android:gravity="center" android:textStyle="bold"
        android:background="@drawable/widget_preview_ring" android:text="1.903" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:text="● 196 kcal" android:textColor="#C239B3" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:text="● +217 kcal" android:textColor="#EAA300" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:text="● 1,2 / 2,5 l" android:textColor="#4F8FE0" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:background="@drawable/widget_preview_dot" android:src="@drawable/ic_add" android:contentDescription="@null" />
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:layout_marginTop="6dp" android:padding="9dp" android:background="@drawable/widget_preview_dot" android:src="@drawable/ic_barcode" android:contentDescription="@null" />
    </LinearLayout>
</LinearLayout>
