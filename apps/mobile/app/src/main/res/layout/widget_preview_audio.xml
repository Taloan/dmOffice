<?xml version="1.0" encoding="utf-8"?>
<!-- Vorschau in der Widget-Auswahl (Beispielwerte) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:background="@drawable/widget_bg">
    <ImageView android:layout_width="56dp" android:layout_height="56dp" android:padding="14dp" android:background="@drawable/widget_preview_dot"
        android:src="@drawable/ic_audio_music_note" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:text="Song" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="1" android:alpha="0.7" android:text="Artist" />
    </LinearLayout>
    <ImageView android:layout_width="44dp" android:layout_height="44dp" android:padding="9dp" android:background="@drawable/widget_preview_dot"
        android:src="@drawable/ic_audio_play" android:contentDescription="@null" />
</LinearLayout>
