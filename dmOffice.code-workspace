{
  "folders": [
    { "name": "dmOffice", "path": "." }
  ],
  "settings": {
    "files.exclude": { "**/bin": true, "**/obj": true, "**/node_modules": true, "data": true },
    "dotnet.defaultSolution": "DmOffice.slnx"
  },
  "extensions": {
    "recommendations": ["ms-dotnettools.csdevkit", "dbaeumer.vscode-eslint", "ms-azuretools.vscode-docker"]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "dmOffice Server",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "build",
        "program": "${workspaceFolder}/DmOffice.Server/bin/Debug/net10.0/DmOffice.Server.dll",
        "cwd": "${workspaceFolder}/DmOffice.Server",
        "env": { "ASPNETCORE_URLS": "http://localhost:5099", "DMOFFICE_DATA": "${workspaceFolder}/data", "ASPNETCORE_ENVIRONMENT": "Development" }
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      { "label": "build", "command": "dotnet", "type": "process", "args": ["build", "${workspaceFolder}/DmOffice.slnx"], "problemMatcher": "$msCompile" },
      { "label": "web: dev", "type": "npm", "script": "dev", "path": "web", "isBackground": true, "problemMatcher": [] },
      { "label": "test", "command": "dotnet", "type": "process", "args": ["test", "${workspaceFolder}/DmOffice.slnx"], "problemMatcher": "$msCompile", "group": "test" }
    ]
  }
}
