<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Beispiel-Plugin nur für die Tests (PluginHostTests): Server-Teil gegen DmOffice.Sdk, mit einer eigenen NuGet-Abhängigkeit,
    die der Kern nicht mitbringt (Humanizer.Core) - prüft, dass der Kern Abhängigkeiten aus dem Plugin-Ordner lädt.
    So sieht auch ein echtes Plugin aus: DmOffice.Sdk nur zum Bauen (Private=false), Abhängigkeiten neben die DLL.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Humanizer.Core" Version="2.14.1" />
    <ProjectReference Include="..\DmOffice.Sdk\DmOffice.Sdk.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
